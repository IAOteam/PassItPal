# PassItPal Environment Variables
# -------------------------------------
# This file contains all the environment variables needed to run the application.
# Copy this file to .env and fill in the values for your local development environment.
#
# To generate a strong secret for JWT_SECRET and JWT_REFRESH_SECRET, you can use:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ----- General -----
NODE_ENV=development # 'development' or 'production'
PORT=5001 # Port for the backend server
CLIENT_URL=http://localhost:5173 # URL of the frontend application

# ----- Frontend (Vite) -----
# These variables are prefixed with VITE_ and are exposed to the frontend.
VITE_BACKEND_URL=http://localhost:5001/api # URL of the backend API
VITE_SOCKET_SERVER_URL=http://localhost:5001 # URL for the Socket.IO server
VITE_RAZORPAY_KEY_ID= # Your Razorpay Key ID
VITE_GA_MEASUREMENT_ID= # Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
VITE_MAPS_API_KEY= # Google Maps API Key for the frontend

# ----- Database (MongoDB) -----
MONGO_URI=mongodb://mongo:27017/passitpal # MongoDB connection string

# ----- Cache & Queue (Redis) -----
REDIS_URL=redis://redis:6379 # Redis connection string

# ----- Authentication (JWT) -----
JWT_SECRET= # A strong, random string for signing JWTs
JWT_REFRESH_SECRET= # A strong, random string for signing refresh JWTs
JWT_EXPIRES_IN=1h # Expiration time for access tokens (e.g., 15m, 1h, 1d)
JWT_REFRESH_EXPIRES_IN=7d # Expiration time for refresh tokens

# ----- Google OAuth -----
GOOGLE_CLIENT_ID= # Your Google OAuth Client ID
GOOGLE_CLIENT_SECRET= # Your Google OAuth Client Secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/google/callback # OAuth redirect URI

# ----- File Storage (Cloudinary) -----
CLOUDINARY_CLOUD_NAME= # Your Cloudinary cloud name
CLOUDINARY_API_KEY= # Your Cloudinary API key
CLOUDINARY_API_SECRET= # Your Cloudinary API secret

# ----- Payment Gateway (Razorpay) -----
RAZORPAY_KEY_ID= # Your Razorpay Key ID
RAZORPAY_KEY_SECRET= # Your Razorpay Key Secret

# ----- Email (SMTP) -----
# Used for sending transactional emails (e.g., password reset, welcome email)
SMTP_HOST= # SMTP server host (e.g., smtp.mailtrap.io)
SMTP_PORT= # SMTP server port (e.g., 2525)
SMTP_SECURE=false # 'true' for SSL/TLS, 'false' otherwise
SMTP_USER= # SMTP username
SMTP_PASS= # SMTP password
EMAIL_FROM="PassItPal <noreply@passitpal.com>" # Sender email address

# ----- SMS (Twilio) -----
# Used for sending OTPs via SMS
TWILIO_ACCOUNT_SID= # Your Twilio Account SID
TWILIO_AUTH_TOKEN= # Your Twilio Auth Token
TWILIO_PHONE_NUMBER= # Your Twilio phone number

# ----- Google Maps API (Backend) -----
GOOGLE_MAPS_API_KEY= # Google Maps API Key for backend services (geocoding)

# ----- Other -----
OTP_LENGTH=6 # Length of the generated OTPs