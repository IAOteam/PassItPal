# ---- Stage 1: Base image with dependencies ----
FROM node:22-alpine AS base
WORKDIR /app

# Copy all package.json files from the monorepo root
COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY frontend/package.json ./frontend/
COPY packages/types/package.json ./packages/types/

# Install all monorepo dependencies
RUN npm install

# ---- Stage 2: Build the 'types' package ----
FROM base AS types-builder
WORKDIR /app
COPY packages/types ./packages/types
RUN npm run build --workspace=@passitpal/types

# ---- Stage 3: Build the 'server' package ----
FROM base AS server-builder
WORKDIR /app
# Copy the built types from the previous stage
COPY --from=types-builder /app/packages/types/dist ./packages/types/dist
# Copy server source code
COPY server ./server
RUN npm run build --workspace=server

# ---- Stage 4: Production image ----
FROM node:22-alpine
WORKDIR /app

# Copy production dependencies manifest
COPY --from=server-builder /app/package.json ./
COPY --from=server-builder /app/server/package.json ./server/
COPY --from=server-builder /app/packages/types/package.json ./packages/types/

# Install only production dependencies for the server workspace
RUN npm install --workspace=server --omit=dev

# Copy the built server code and types
COPY --from=server-builder /app/server/dist ./server/dist
COPY --from=server-builder /app/packages/types/dist ./packages/types/dist

# Set the command to run the application
CMD ["node", "server/dist/app.js"]
